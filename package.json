    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
