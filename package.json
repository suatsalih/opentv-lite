{
  "name": "opentv-lite",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTV Lite — a free, open-source IPTV player for Samsung (Tizen) and LG (webOS) TVs.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "mock": "node tools/mock-provider.mjs",
